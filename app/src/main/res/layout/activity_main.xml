<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <Button
            android:id="@+id/btn_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="授权所有文件访问"/>

        <Button
            android:id="@+id/btn_pick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="① 选择主题包 / 字体文件"/>

        <ImageView
            android:id="@+id/meta_preview"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:visibility="gone"
            android:contentDescription="主题预览图"/>

        <TextView
            android:id="@+id/meta_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="12sp"
            android:padding="6dp"
            android:background="#11000000"/>

        <LinearLayout
            android:id="@+id/comps"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"/>

        <Button
            android:id="@+id/btn_deploy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="② 部署到系统主题 (自动备份)"/>

        <Button
            android:id="@+id/btn_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="仅备份当前主题"/>

        <Button
            android:id="@+id/btn_restore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="还原最近一次备份"/>

        <Button
            android:id="@+id/btn_restart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="重启系统界面 (SystemUI)"/>

    <Button
        android:id="@+id/btn_launcher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="重启桌面 (Launcher，部署小组件后使用)"/>

    <Button
        android:id="@+id/btn_community"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="社区主题库（在线浏览 / 获取）"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:background="#11000000">

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:padding="6dp"
                android:text="等待操作…\n"/>
        </ScrollView>
    </LinearLayout>
</ScrollView>
